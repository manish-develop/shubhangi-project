{
  "routes": [
    {
      "src": "http://(.*)",
      "headers": {
        "Location": "https://$1"
      },
      "status": 301
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
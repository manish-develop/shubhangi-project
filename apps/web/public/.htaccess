<IfModule mod_rewrite.c>
	RewriteEngine On

	# Canonicalize to the bare (non-www) domain — without this, www and
	# non-www both served the same content with no redirect between them,
	# which is a duplicate-content issue for SEO.
	RewriteCond %{HTTP_HOST} ^www\.drmaharanas\.com$ [NC]
	RewriteRule ^(.*)$ https://drmaharanas.com/$1 [R=301,L]

	RewriteBase /

	# Social-media link-preview crawlers (WhatsApp, Facebook, Twitter/X,
	# LinkedIn, Slack, Telegram, Discord...) don't execute JavaScript, so
	# they'd otherwise only ever see this SPA's generic index.html shell —
	# no per-post title/image/description in the link card. Send just
	# those user agents to a small PHP script that fetches the real page's
	# data (from WordPress/Yoast for blog posts, our own API for diseases,
	# static values for everything else) and renders proper tags
	# server-side. Everyone else (real visitors, Googlebot, which does run
	# JS) gets the normal React app, untouched.
	RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview) [NC]
	RewriteRule ^blogs/([a-zA-Z0-9-]+)/?$ /bot-prerender.php?kind=blog&slug=$1 [L,QSA]

	RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview) [NC]
	RewriteRule ^disease/([a-zA-Z0-9-]+)/?$ /bot-prerender.php?kind=disease&slug=$1 [L,QSA]

	RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview) [NC]
	RewriteRule ^service/([a-zA-Z0-9-]+)/?$ /bot-prerender.php?kind=service&slug=$1 [L,QSA]

	RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview) [NC]
	RewriteRule ^diseases/?$ /bot-prerender.php?kind=static&page=diseases [L,QSA]

	RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview) [NC]
	RewriteRule ^services/?$ /bot-prerender.php?kind=static&page=services [L,QSA]

	RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview) [NC]
	RewriteRule ^$ /bot-prerender.php?kind=static&page=home [L,QSA]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	# index.html (and any other non-asset file) references content-hashed
	# asset filenames, so it must never be cached long on the CDN — a 7-day
	# cache here was the reason a fresh deploy didn't show up on the live
	# site until the CDN cache expired or was purged.
	Header set Cache-Control "public, s-maxage=60, max-age=0, must-revalidate"

	# Vite content-hashes every filename under /assets/ (a new build always
	# gets new filenames), so these can be cached for a full year without
	# ever serving stale content after a deploy.
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>
